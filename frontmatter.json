{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.snippets.wrapper.enabled": false,
  "frontMatter.templates.enabled": true,
  "frontMatter.templates.folder": ".frontmatter/templates",
  "frontMatter.config.dynamicFilePath": "[[workspace]]/frontmatter.config.cjs",
  "frontMatter.extensibility.scripts": [
    "[[workspace]]/.frontmatter/ui/data-select-colors.js",
    "[[workspace]]/.frontmatter/ui/news-id.mjs"
  ],
  "frontMatter.content.publicFolder": "src/assets/img/hirfolyam",
  "frontMatter.content.pageFolders": [
    {
      "title": "Hírszövegek és közös tartalmak",
      "path": "[[workspace]]/src/content",
      "excludeSubdir": true,
      "disableCreation": true
    }
  ],
  "frontMatter.data.files": [
    {
      "id": "news-2026-27",
      "title": "Hírek 2026/2027 (aktuális tanév)",
      "file": "[[workspace]]/src/data/news-2026-27.yml",
      "fileType": "yaml",
      "labelField": "title",
      "singleEntry": false,
      "schema": {
        "title": "Hír",
        "type": "object",
        "required": ["title", "site", "img", "align", "imgclass", "contentclass"],
        "properties": {
          "title": {
            "type": "string",
            "title": "A hír címe",
            "minLength": 1
          },
          "site": {
            "type": "string",
            "title": "Megjelenés (ps = Petőfi, bs = Bálint, common = mindkettő)",
            "enum": ["ps", "bs", "common"],
            "default": "ps"
          },
          "img": {
            "type": "string",
            "title": "Hírkép (kép nélkül: nincs)",
            "description": "Előbb töltsd fel a Media fülön, majd futtasd a Refresh Front Matter Settings parancsot. Ezután itt kiválaszthatod a fájlt.",
            "default": "nincs",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "title": "Tartalomazonosító (automatikus)",
            "description": "Új hírnél mentéskor kap newsNN azonosítót és szövegblokkot. Meglévő hír azonosítója változatlan marad."
          },
          "align": {
            "type": "string",
            "title": "Kép igazítása",
            "enum": ["left", "center", "right"],
            "default": "center"
          },
          "imgclass": {
            "type": "string",
            "title": "Kép oszlopszélessége (pl. medium-3)",
            "default": "medium-3",
            "minLength": 1
          },
          "contentclass": {
            "type": "string",
            "title": "Tartalom oszlopszélessége (pl. medium-9)",
            "default": "medium-9",
            "minLength": 1
          }
        }
      }
    }
  ],
  "frontMatter.content.snippets": {
    "HIR - YAML bejegyzés (news-*.yml)": {
      "description": "Új hír a src/data/news-2026-27.yml lista LEGELEJÉRE (Ctrl+Home), tanévi gyűjtőkulcs nélkül. A content mező a következő szabad newsNN legyen!",
      "body": [
        "- site: [[site]]",
        "  title: >-",
        "    [[&title]]",
        "  img: [[img]]",
        "  align: center",
        "  imgclass: [[imgclass]]",
        "  contentclass: [[contentclass]]",
        "  content: [[content]]",
        ""
      ],
      "fields": [
        {
          "name": "site",
          "title": "Iskolakulcs (ps / bs / common)",
          "type": "choice",
          "choices": ["ps", "bs", "common"],
          "default": "ps"
        },
        {
          "name": "title",
          "title": "A hír címe",
          "type": "string"
        },
        {
          "name": "img",
          "title": "Képfájl neve a hirfolyam mappából (pl. ujhir.jpg)",
          "type": "string"
        },
        {
          "name": "imgclass",
          "title": "Kép oszlopszélessége",
          "type": "string",
          "default": "medium-3"
        },
        {
          "name": "contentclass",
          "title": "Tartalom oszlopszélessége",
          "type": "string",
          "default": "medium-9"
        },
        {
          "name": "content",
          "title": "newsNN (a következő szabad szám, pl. news07)",
          "type": "string"
        }
      ]
    },
    "HIR - Tartalom blokk (common-news-content-*.md)": {
      "description": "Handlebars tartalom blokk a common-news-content-*.md fájl VÉGÉRE. A contentId-nek egyeznie kell a YAML-ben használt newsNN-nel!",
      "body": [
        "{{#ifequal hir \"[[contentId]]\"}}",
        "",
        "[[&content]]",
        "",
        "{{/ifequal}}",
        ""
      ],
      "fields": [
        {
          "name": "contentId",
          "title": "newsNN azonosító (pl. news07)",
          "type": "string"
        },
        {
          "name": "content",
          "title": "A hír szövege (Markdown/HTML)",
          "type": "string"
        }
      ]
    },
    "HIR - Táblázat sor (időpontlistákhoz)": {
      "description": "3 oszlopos táblázatsor a hír tartalmába (pl. szülői értekezletek: osztály, dátum, időpont).",
      "body": [
        "|           |                  |       |",
        "|-----------|------------------|-------|",
        "| [[col1]]        | [[col2]]               | [[col3]]    |"
      ],
      "fields": [
        {
          "name": "col1",
          "title": "1. oszlop (pl. 1. oszt.)",
          "type": "string"
        },
        {
          "name": "col2",
          "title": "2. oszlop (pl. aug. 31. hétfő)",
          "type": "string"
        },
        {
          "name": "col3",
          "title": "3. oszlop (pl. 17:00)",
          "type": "string"
        }
      ]
    }
  },
  "frontMatter.git.enabled": false
}
